# General Settings
EMERGENCY_MODE=false
STEAM_API_KEY=your_steam_api_key
INTERNAL_API_KEY=your_internal_api_key
STEAM_PROXY_URL=your_steam_proxy_url
STEAM_PROXY_API_KEY=your_steam_proxy_api_key

# Redis
REDIS_URL=redis://localhost:6379

# S3 Storage
S3_REGION=your_region
S3_BUCKET=your_bucket
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_ENDPOINT=your_endpoint

# S3 Cache
S3_CACHE_REGION=your_region
S3_CACHE_BUCKET=your_bucket
S3_CACHE_ACCESS_KEY_ID=your_access_key
S3_CACHE_SECRET_ACCESS_KEY=your_secret_key
S3_CACHE_ENDPOINT=your_endpoint

# MCP (public data lake queried by /v1/mcp; default shown)
MCP_SNAPSHOT_MANIFEST_URL=https://data.deadlock-api.com/v1/manifest.json

# Public data lake dump (hourly export of the public tables to R2; off by default)
DATA_DUMP_ENABLED=false
DATA_DUMP_BUCKET=deadlock-data-lake
DATA_DUMP_PUBLIC_URL=https://data.deadlock-api.com
DATA_DUMP_ACCESS_KEY_ID=your_r2_access_key
DATA_DUMP_SECRET_ACCESS_KEY=your_r2_secret_key
DATA_DUMP_USERNAME=dump_user
DATA_DUMP_PASSWORD=your_password
# DATA_DUMP_PREFIX=v1
# DATA_DUMP_NAMED_COLLECTION=r2_dump
# DATA_DUMP_REBUILD_PER_TICK=2

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=your_password
CLICKHOUSE_DBNAME=default
CLICKHOUSE_RESTRICTED_USERNAME=readonly
CLICKHOUSE_RESTRICTED_PASSWORD=your_password
CLICKHOUSE_ALLOW_CUSTOM_QUERIES=true

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DBNAME=postgres
POSTGRES_POOL_SIZE=10

# Patreon
PATREON_CLIENT_ID=your_patreon_client_id
PATREON_CLIENT_SECRET=your_patreon_client_secret
PATREON_REDIRECT_URI=http://localhost:8080/v1/auth/patreon/callback
PATREON_FRONTEND_REDIRECT_URL=http://localhost:3000/patreon/callback
# Use a single PARENT domain so the cookie is sent to ALL subdomains (api., ai., www., ...).
# Do NOT list sibling hosts like "api.deadlock-api.com,ai.deadlock-api.com": a host can only
# set a cookie for its own host or a parent domain, so api.* setting Domain=ai.* is rejected
# by the browser, and Domain=api.* is never sent to the sibling ai.*.
PATREON_COOKIE_DOMAINS=.deadlock-api.com
PATREON_CAMPAIGN_ID=your_patreon_campaign_id
PATRON_ENCRYPTION_KEY=your_32_byte_hex_encryption_key
PATRON_WEBHOOK_SECRET=whatever-secret

# Auth & Encryption
JWT_SECRET=your_jwt_secret_at_least_32_chars
