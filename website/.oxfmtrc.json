{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": {},
  "sortTailwindcss": {
    "stylesheet": "src/styles/tailwind.css",
    "functions": ["clsx", "cn", "cva"]
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".output",
    ".tanstack",
    ".vinxi",
    ".wrangler",
    "src/routeTree.gen.ts",
    "wrangler.jsonc",
    ".claude/skills/impeccable",
    ".claude/skills/web-design-guidelines",
    ".claude/skills/a11y-core",
    ".claude/skills/contrast-master",
    ".claude/skills/data-visualization-accessibility",
    ".claude/skills/design-system-auditor",
    ".claude/skills/accessibility-regression-detector"
  ]
}
