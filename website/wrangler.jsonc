{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deadlock-api",
  "workers_dev": true,
  // Per-PR preview versions (see .github/workflows/website-ci.yml) are served on workers.dev.
  "preview_urls": true,
  "main": "./dist/server/server.js",
  "compatibility_date": "2026-05-14",
  "keep_names": false,
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/_serverFn/*", "/streamkit/widgets/*", "/players", "/players/*",
      "/analytics", "/analytics/*", "/community", "/community/*",
      "/tracker", "/tracker/*",
      "/games", "/games/*", "/heroes", "/heroes/*", "/items", "/items/*", "/abilities", "/abilities/*",
      "/team-builder", "/team-builder/*", "/leaderboard", "/leaderboard/*",
      "/badge-distribution", "/badge-distribution/*", "/heatmap", "/heatmap/*",
      "/deadlockdle", "/deadlockdle/*", "/flashcards", "/flashcards/*",
      "/patches", "/patches/*",
      "/data-dumps", "/streamkit", "/crosshair", "/compare", "/og/compare.png", "/og/crosshair.png", "/.well-known/*"
    ]
  },
  "routes": [
    { "pattern": "deadlock-api.com", "custom_domain": true },
    { "pattern": "www.deadlock-api.com", "custom_domain": true }
  ],
  // The AI search's questions per visitor (src/lib/ai-search/rate-limit.ts): each costs a model call. Counted per
  // Cloudflare location, so the limit is approximate. The namespace id is any number unique in the account.
  "ratelimits": [
    { "name": "AI_SEARCH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  // Guess the Rank (src/lib/guess-the-rank): the video catalog and the community's votes in D1, the videos in R2.
  // A separate pipeline uploads the videos and inserts their rows; the site only reads `videos` and writes votes.
  "d1_databases": [
    {
      "binding": "GUESS_THE_RANK_DB",
      "database_name": "guess-the-rank",
      "database_id": "4bc641d1-a277-4339-94dd-179dcf66931c",
      "migrations_dir": "migrations/guess-the-rank"
    }
  ],
  "r2_buckets": [{ "binding": "GUESS_THE_RANK_VIDEOS", "bucket_name": "guess-the-rank" }],
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  }
}
