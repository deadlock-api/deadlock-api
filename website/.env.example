# API base URLs
VITE_API_BASE_URL=https://api.deadlock-api.com

# PostHog project token (phc_...). Optional: the public token is built into src/lib/analytics.ts; set this only to override it.
VITE_PUBLIC_POSTHOG_TOKEN=

# PostHog personal API key (phx_...) and project id, used only by the local /posthog and /ux-review skills
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_API_KEY=
